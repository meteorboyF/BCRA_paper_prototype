# Two-host validation — client configuration.
# Copy to config.env, fill in the two values the SERVER session prints,
# then:  source config.env
export PANGOCHAIN_API_URL="http://SERVER_LAN_IP:8080/api"   # printed by the server session
export PANGOCHAIN_FIRM_ID="FILL_FROM_SERVER_SESSION"        # firm UUID from the server DB
export PANGOCHAIN_CONCURRENCY=50
export PANGOCHAIN_DURATION_SEC=60
